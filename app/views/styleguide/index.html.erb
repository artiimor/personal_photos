<% content_for :title, "Styleguide" %>

<div class="w-full space-y-12 py-12">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Styleguide</h1>
    <p class="mt-1 text-sm text-gray-500">Development only &mdash; a catalog of the components and styles used across the app.</p>
  </div>

  <%# Colors %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Colors</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
      <% [
        ["green-800", "bg-green-800"], ["green-700", "bg-green-700"], ["green-600", "bg-green-600"],
        ["gray-900", "bg-gray-900"], ["gray-500", "bg-gray-500"], ["gray-300", "bg-gray-300"],
        ["gray-200", "bg-gray-200"], ["gray-50", "bg-gray-50"],
        ["red-800", "bg-red-800"], ["red-700", "bg-red-700"], ["red-200", "bg-red-200"], ["red-50", "bg-red-50"],
      ].each do |name, bg| %>
        <div>
          <div class="h-16 w-full rounded-lg ring-1 ring-gray-200 <%= bg %>"></div>
          <p class="mt-1 text-xs text-gray-500"><%= name %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# Typography %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Typography</h2>
    <div class="space-y-2 rounded-2xl bg-white p-6 ring-1 ring-gray-200">
      <p class="text-3xl font-bold text-gray-900">Heading / page title &mdash; text-3xl font-bold</p>
      <p class="text-2xl font-semibold text-gray-900">Heading / card title &mdash; text-2xl font-semibold</p>
      <p class="text-sm font-medium text-gray-700">Label &mdash; text-sm font-medium text-gray-700</p>
      <p class="text-sm text-gray-500">Body / helper text &mdash; text-sm text-gray-500</p>
      <p class="text-xs text-gray-500">Caption &mdash; text-xs text-gray-500</p>
    </div>
  </section>

  <%# Buttons & links %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Buttons &amp; links</h2>
    <div class="flex flex-wrap items-center gap-4 rounded-2xl bg-white p-6 ring-1 ring-gray-200">
      <button class="cursor-pointer rounded-lg bg-green-700 px-4 py-2 font-medium text-white transition hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2">
        Primary button
      </button>
      <button disabled class="cursor-not-allowed rounded-lg bg-green-700 px-4 py-2 font-medium text-white opacity-50">
        Disabled
      </button>
      <a href="#" class="text-green-800 hover:text-green-900 hover:underline">Text link</a>
    </div>
  </section>

  <%# Form elements %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Form elements</h2>
    <div class="max-w-md space-y-4 rounded-2xl bg-white p-6 ring-1 ring-gray-200">
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Text input</label>
        <input type="text" placeholder="Placeholder"
               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 placeholder-gray-400 focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600">
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-green-700 focus:ring-green-600">
        <label class="text-sm text-gray-600">Checkbox label</label>
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">File input</label>
        <input type="file" class="block w-full text-sm text-gray-700">
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-gray-700">Drag &amp; drop (photos/new)</label>
        <div class="relative flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 px-6 py-10 text-center transition">
          <svg class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
          </svg>
          <p class="mt-2 text-sm text-gray-600">
            <span class="font-medium text-green-700">Click to upload</span> or drag and drop
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# Cards %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Card shell</h2>
    <div class="flex w-full max-w-md rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
      <div>
        <h3 class="mb-2 text-2xl font-semibold text-gray-900">Card title</h3>
        <p class="text-sm text-gray-500">Used by auth pages, home and photos (<code>rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200</code>).</p>
      </div>
    </div>
  </section>

  <%# Alerts %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Alerts</h2>
    <div class="max-w-md space-y-4">
      <div class="rounded-lg border border-red-200 bg-red-50 p-4">
        <h4 class="mb-2 text-sm font-semibold text-red-800">2 errors prohibited this from being saved</h4>
        <ul class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <li>Email can't be blank</li>
          <li>Password is too short</li>
        </ul>
      </div>
      <div class="rounded-lg bg-red-50 p-3 text-sm text-red-700">Inline error message</div>
    </div>
  </section>

  <%# Photo thumbnail %>
  <section>
    <h2 class="mb-4 text-xl font-semibold text-gray-900">Photo thumbnail</h2>
    <div class="w-32 overflow-hidden rounded-lg ring-1 ring-gray-200">
      <div class="h-32 w-full bg-gray-200"></div>
      <p class="truncate px-2 py-1 text-sm text-gray-700">filename.jpg</p>
    </div>
  </section>
</div>
