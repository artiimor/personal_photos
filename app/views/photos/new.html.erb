<div class="flex w-full justify-center py-12">
  <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
    <h1 class="mb-6 text-2xl font-semibold text-gray-900"><%= t(".title") %></h1>

    <% if @photo.errors.any? %>
      <div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700">
        <% @photo.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @photo, url: photos_path, multipart: true do |f| %>
      <div class="mb-6">
        <%= f.file_field :file, accept: "image/*", required: true,
              class: "block w-full text-sm text-gray-700" %>
      </div>

      <%= f.submit t(".submit"),
            class: "w-full cursor-pointer rounded-lg bg-green-700 px-4 py-2 font-medium text-white transition hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2" %>
    <% end %>
  </div>
</div>
