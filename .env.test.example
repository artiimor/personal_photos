# Only used to fill in the ${...} variables of docker-compose.yml when running the tests.
# The rest of the container's variables still come from .env.
# POSTGRES_* must match .env, or Compose will recreate the db container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=personal_photos_development

# Points to the test database, not POSTGRES_DB, so the tests never touch development data.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/personal_photos_test
REDIS_URL=redis://redis:6379/2
